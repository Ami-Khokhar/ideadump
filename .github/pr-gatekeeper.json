{
  "verify": "command -v xcodegen >/dev/null 2>&1 || brew install xcodegen; xcodegen generate && xcodebuild test -project TapLog.xcodeproj -scheme TapLog -destination 'platform=iOS Simulator,name=iPhone 17,OS=latest' -testLanguage en -testRegion IN CODE_SIGNING_ALLOWED=NO",
  "test_file_globs": [
    "tests/test_*.py",
    "test/test_*.py"
  ],
  "docs_globs": [
    "*.md",
    "*.rst",
    "docs/*"
  ],
  "test_command": "python3 -m unittest {files}",
  "protected_paths": [
    ".github/",
    ".env",
    ".env.local",
    "secrets/",
    ".claude/settings.json",
    ".codex/config.toml"
  ],
  "max_changed_lines": 600,
  "max_changed_files": 20,
  "max_rounds": 3,
  "run_allowlist": [
    "python3 -m unittest",
    "pytest",
    "uv run pytest",
    "npm test"
  ],
  "reviewer_model": "deepseek-v4.1-flash",
  "verifier_model": "glm-5.3-flash",
  "merge_method": "squash",
  "notify": "",
  "supported_platforms": [],
  "strong_reviewer_model": "",
  "sensitive_paths": [
    "*auth*",
    "*token*",
    "*secret*",
    "*crypt*",
    "*permission*",
    "*password*",
    "*credential*",
    "*process*",
    "*signal*",
    "*sandbox*"
  ],
  "sensitive_code": [
    "\\bsubprocess\\b",
    "\\bos\\.(kill|killpg|setsid|setpgid|fork|exec\\w*|chmod|umask)\\b",
    "\\bsignal\\.",
    "\\bshell\\s*=\\s*True\\b",
    "(?i)\\b(pid|pgid|process group|setsid|killpg|sig(kill|term|int|hup))\\b",
    "/proc/",
    "(?i)\\b(token|password|secret|api[_-]?key|authorization|bearer)\\b"
  ]
}
